# Every value here is the default — copy this file to .env only to change one.

# ---------------------------------------------------------------- identity
# .test is reserved by RFC 6761 for exactly this, so it can never collide
# with a real domain or leak to a real DNS server.
MAIL_DOMAIN=tahidromos.test
MAIL_HOSTNAME=mail.tahidromos.test
# Extra domains to deliver locally, on top of the ones in tahidromos.d/*.yml
MAIL_LOCAL_DOMAINS=

# ---------------------------------------------------------------- mailboxes
# Used only when there is no tahidromos.d/*.yml. "user" or "user:password".
MAIL_ACCOUNTS=alice,bob,carol,dave,support,sales,noreply,postmaster,echo,echo2
MAIL_DEFAULT_PASSWORD=password
# Create unknown local addresses on first delivery, so random test
# addresses like user-8f21a@tahidromos.test just work.
MAIL_AUTO_CREATE=true

# ---------------------------------------------------------------- echo bots
BOT_ENABLED=true
BOT_ACCOUNTS=echo,echo2
BOT_MODE=echo          # echo | mirror | ack | counter
BOT_MAX_DEPTH=8        # where a bot-to-bot chain stops
BOT_DELAY=0.5          # seconds before answering
BOT_POLL=1
BOT_REPLY_TO_BOTS=true

# ---------------------------------------------------------------- ports
PORT_SMTP=1025
PORT_SUBMISSION=1587
PORT_SUBMISSION_TLS=1465
PORT_IMAP=1143
PORT_IMAPS=1993
PORT_HTTP=8080

# ---------------------------------------------------------------- misc
ENABLE_TLS=true
LOG_LEVEL=INFO
